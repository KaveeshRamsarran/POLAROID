{
  "name": "polaroid",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader native",
    "build": "vite build --configLoader native",
    "preview": "vite preview --host 127.0.0.1 --configLoader native",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node scripts/smoke.mjs",
    "test:systems": "node scripts/systems.mjs",
    "test:progression": "node scripts/progression.mjs",
    "test:death": "node scripts/death.mjs",
    "format": "prettier --write src scripts tests index.html vite.config.js package.json README.md",
    "test:polish": "node scripts/polish.mjs",
    "test:characters": "node scripts/characters.mjs",
    "test:cinema": "node scripts/cinema.mjs",
    "test:cinema-systems": "node scripts/cinema-systems.mjs",
    "test:cinema-routes": "node scripts/cinema-routes.mjs",
    "test:anthology": "node scripts/anthology.mjs",
    "test:cinema-photos": "node scripts/cinema-photos.mjs",
    "test:cinema-presentation": "node scripts/cinema-presentation.mjs",
    "test:cinema-doors": "node scripts/cinema-door-regression.mjs",
    "test:analog-style": "node scripts/analog-style.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "prettier": "^3.6.2",
    "vite": "7.1.7"
  }
}
